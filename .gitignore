# Dependencies
node_modules/

# Build output (regenerated by `npm run build`)
www/app.js
www/app.js.map

# Capacitor native projects.
#
# android/ IS tracked, deliberately. It started as generated output, but it now
# carries hand-made changes that cannot be regenerated: the microphone
# permission, the Android 11+ <queries> block, the launcher icons and the splash
# screen. Ignoring it would silently throw those away on a fresh clone.
#
# Its build output is another matter — regenerated every build, large, and
# machine-specific.
android/app/build/
android/build/
android/.gradle/
android/.idea/
android/local.properties
android/app/release/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# iOS is not set up yet; regenerate with `npx cap add ios` on a Mac.
ios/

# Signing material — NEVER commit these
*.keystore
*.jks
keystore.properties
*.p12
*.mobileprovision

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Word's temporary lock and recovery files. They appear whenever a .docx in this
# folder is open, and committing one produces a file nobody can open.
~$*
~WRL*.tmp
*.tmp

# Your own working notes. Excluded because this repository is published: a
# planning document is not something to put on the open internet by accident.
# Delete this line if you would rather it were tracked.
Mobile Translator App Development.docx
Mobile Translator App Development-Travel Translator-4L-Claude.docx

# Screenshots and text Claude produced while working on the app. Working material, not app source.
Claude outputs/

# Staging area for files waiting to be removed. Nothing here belongs in history.
_to_delete/

# Downloaded installers and archives.
#
# This is not hypothetical: the 294 MB GitHub Desktop installer was sitting in
# this folder, and GitHub rejects any single file over 100 MB — the first push
# would have failed with an error that does not obviously point at the cause.
# Anything committed once stays in the repository's history forever, even after
# you delete it, so the cheap fix is to never let it in.
*.exe
*.msi
*.dmg
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Local overrides
.env
.env.local

# Whole folder holding the release keystore, its plaintext password file and
# its base64 export (used only to paste into a GitHub secret). Belt and
# braces alongside the *.jks / keystore.properties rules above.
/keys/
