<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Speaking into the app. Android maps the plugin's "speechRecognition"
         permission onto RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Used ONLY to download the offline language packs. Once they are on the
         phone the app never touches the network again. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- So the app can warn "you are on mobile data" before a 30 MB download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Declaring a microphone as optional, not required: the app is fully
         usable by typing, and requiring hardware would exclude devices from
         the Play Store listing for no reason. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11 and later hide other installed apps unless you say which
         kinds you need to see. Without this the app cannot find the speech
         recogniser or the text-to-speech voices, and Settings would wrongly
         report "not available" on a phone that has them. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
